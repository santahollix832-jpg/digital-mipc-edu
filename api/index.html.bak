<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital MIPC EDU - Smart School Management System</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .page-content { display: none; }
        .page-content.active { display: block; }
    </style>
</head>
<body class="bg-[#f8fafc] text-slate-800 min-h-screen flex flex-col md:flex-row">

    <aside class="w-full md:w-64 bg-[#0f172a] text-slate-300 flex flex-col justify-between shrink-0 border-r border-slate-800">
        <div>
            <div class="p-6 flex items-center gap-3 border-b border-slate-800">
                <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white font-black text-xl shadow-lg">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h1 class="text-white font-bold text-sm tracking-tight leading-none">Digital MIPC EDU</h1>
                    <span class="text-[11px] text-slate-500 font-medium">Smart School System</span>
                </div>
            </div>

            <nav class="p-4 space-y-1" id="sidebar-nav">
                <button onclick="switchPage('dashboard')" id="nav-dashboard" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold bg-indigo-600 text-white rounded-xl cursor-pointer">
                    <i class="fa-solid fa-chart-pie w-5 text-center"></i> Dashboard
                </button>
                <button onclick="switchPage('students')" id="nav-students" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-xl cursor-pointer">
                    <i class="fa-solid fa-user-graduate w-5 text-center"></i> Students
                </button>
                <button onclick="switchPage('staff')" id="nav-staff" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-xl cursor-pointer">
                    <i class="fa-solid fa-user-tie w-5 text-center"></i> Staff
                </button>
            </nav>
        </div>

        <div class="p-4 border-t border-slate-800 bg-[#0b0f19]/40 flex items-center gap-3">
            <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center font-bold text-white text-sm">AU</div>
            <div>
                <h4 class="text-xs font-bold text-white leading-none">Admin User</h4>
                <span class="text-[10px] text-slate-500">System Administrator</span>
            </div>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        
        <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between sticky top-0 z-40">
            <h2 class="text-base font-bold text-slate-800" id="page-title">Welcome back, Admin! 👋</h2>
            <div class="flex items-center gap-4">
                <div class="text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1.5 rounded-lg"><span id="system-date">Loading...</span></div>
                <div class="text-xs font-bold text-slate-700 bg-indigo-50 px-3 py-1.5 rounded-lg"><span id="live-clock">--:--:--</span></div>
            </div>
        </header>

        <main class="p-6 max-w-7xl w-full mx-auto">
            
            <div id="page-dashboard" class="page-content active space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 flex items-center justify-between">
                        <div><span class="text-slate-400 text-xs font-bold uppercase block">Total Students</span><span id="stat-total" class="text-2xl font-black">--</span></div>
                        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center"><i class="fa-solid fa-user-graduate"></i></div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 flex items-center justify-between">
                        <div><span class="text-slate-400 text-xs font-bold uppercase block">Total Staff</span><span class="text-2xl font-black">86</span></div>
                        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center"><i class="fa-solid fa-user-tie"></i></div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 flex items-center justify-between">
                        <div><span class="text-slate-400 text-xs font-bold uppercase block">Attendance Rate</span><span id="stat-rate" class="text-2xl font-black">--</span></div>
                        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center"><i class="fa-solid fa-chart-line"></i></div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 flex items-center justify-between">
                        <div><span class="text-slate-400 text-xs font-bold uppercase block">Absent Logs</span><span id="stat-absent" class="text-2xl font-black text-rose-600">--</span></div>
                        <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center"><i class="fa-solid fa-user-xmark"></i></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl overflow-hidden">
                        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                            <h3 class="font-bold text-slate-800 text-sm">Realtime Presence Stream</h3>
                            <button onclick="fetchData()" class="px-3 py-1.5 bg-indigo-600 text-white text-xs font-bold rounded-lg"><i class="fa-solid fa-arrows-rotate mr-1"></i> Sync DB</button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-200"><th class="p-4 pl-6">Student</th><th class="p-4">Class</th><th class="p-4">Timestamp</th><th class="p-4 pr-6 text-right">Status</th></tr>
                                </thead>
                                <tbody id="attendance-rows" class="divide-y divide-slate-100 text-slate-600 font-medium"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="bg-slate-900 text-slate-200 p-5 rounded-2xl border border-slate-800 font-mono text-xs space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-2"><span class="text-amber-400 font-bold"><i class="fa-solid fa-terminal mr-1"></i> Hardware Simulator</span></div>
                        <div class="space-y-2">
                            <button onclick="simulateHardwareScan(1, 'card')" class="w-full p-2.5 bg-slate-800 hover:bg-indigo-900 text-left rounded-xl border border-slate-7