$ErrorActionPreference = 'Stop'

if (-not (Test-Path '.\api\.env')) {
    throw 'api\.env was not found. Run this script from the repository root.'
}
if (-not (Test-Path '.\database\01_schema.sql')) {
    throw 'database\01_schema.sql was not found. Run this script from the repository root.'
}
if (-not (Test-Path '.\api\node_modules\pg') -or -not (Test-Path '.\api\node_modules\dotenv')) {
    throw 'API     fetch('/api/students', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });    .\fix-render-schema.ps1    $ErrorActionPreference = 'Stop'
    
    # Run this from the repository root (smart-school)
    # Example:
    #   cd C:\Users\TEH HEAVEN\Desktop\smart-school
    #   .\fix-render-schema.ps1
    
    $repoRoot = (Get-Location).Path
    $envFile = Join-Path $repoRoot 'api\.env'
    $schemaFile = Join-Path $repoRoot 'database\01_schema.sql'
    
    if (-not (Test-Path $envFile)) {
        throw "Missing .env file: $envFile"
    }
    
    if (-not (Test-Path $schemaFile)) {
        throw "Missing schema file: $schemaFile"
    }
    
    # Read DATABASE_URL from api/.env
    $databaseUrl = $null
    Get-Content $envFile | ForEach-Object {
        $line = $_.Trim()
        if ($line -match '^\s*#' -or [string]::IsNullOrWhiteSpace($line)) { return }
        if ($line -match '^\s*DATABASE_URL\s*=\s*(.+?)\s*$') {
            $databaseUrl = $matches[1].Trim("'`"")
        }
    }
    
    if ([string]::IsNullOrWhiteSpace($databaseUrl)) {
        throw "DATABASE_URL not found in $envFile"
    }
    
    # Ensure SSL is enabled for Render Postgres
    if ($databaseUrl -notmatch 'sslmode=') {
        $separator = if ($databaseUrl.Contains('?')) { '&' } else { '?' }
        $databaseUrl = "$databaseUrl$separator" + 'sslmode=require'
    }
    
    Write-Host "Using DATABASE_URL from api/.env"
    Write-Host "Connection target: $databaseUrl"
    
    # Check psql availability
    $psql = Get-Command psql -ErrorAction Stop
    Write-Host "Using psql: $($psql.Source)"
    
    # Test if students table exists
    $tableCheckSql = @"
    SELECT to_regclass('public.students');
    "@
    
    $tableExists = & psql "$databaseUrl" -X -t -A -v ON_ERROR_STOP=1 -c "$tableCheckSql"
    $tableExists = ($tableExists | Out-String).Trim()
    
    if ($tableExists -eq '') {
        Write-Host "students table is missing. Applying schema from database/01_schema.sql ..."
        & psql "$databaseUrl" -X -v ON_ERROR_STOP=1 -f "$schemaFile"
        if ($LASTEXITCODE -ne 0) { throw "Schema application failed." }
    } else {
        Write-Host "students table already exists. Skipping schema creation."
    }
    
    # Seed one sample student using compatible schema columns from 01_schema.sql
    # This avoids 02_sample_data.sql, which may contain incompatible columns.
    $sampleStudentSql = @"
    INSERT INTO students (name, reg_number, class, gender, photo_url)
    VALUES ('Amina Kibet', 'STU-1001', 'Form 4A', 'Female', 'default.png')
    ON CONFLICT (reg_number) DO NOTHING;
    "@
    
    Write-Host "Seeding one compatible sample student..."
    & psql "$databaseUrl" -X -v ON_ERROR_STOP=1 -c "$sampleStudentSql"
    if ($LASTEXITCODE -ne 0) { throw "Sample student insertion failed." }
    
    # Verify schema and table exists
    $verifySql = @"
    SELECT table_name
    FROM information_schema.tables
    WHERE table_schema = 'public'
    ORDER BY table_name;
    
    SELECT COUNT(*) AS student_count FROM students;
    
    SELECT id, name, reg_number, class, gender, photo_url
    FROM students
    ORDER BY id DESC
    LIMIT 5;
    "@
    
    Write-Host "Verifying schema..."
    & psql "$databaseUrl" -X -v ON_ERROR_STOP=1 -c "$verifySql"
    if ($LASTEXITCODE -ne 0) { throw "Schema verification failed." }
    
    Write-Host ""
    Write-Host "✅ Render PostgreSQL schema is ready."
    Write-Host "✅ students table exists and seeded with one sample student."
    Write-Host "✅ SSL mode is enabled for the remote database connection."dependencies are missing. Run "npm install" from the api directory, then retry.'
}

$nodeScript = @'
const fs = require('fs');
const path = require('path');

const dotenv = require('./api/node_modules/dotenv');
const { Pool } = require('./api/node_modules/pg');

dotenv.config({
  path: path.join(process.cwd(), 'api', '.env'),
  override: true,
});

if (!process.env.DATABASE_URL) {
  console.error('DATABASE_URL is missing from api/.env');
  process.exitCode = 1;
} else {
  const pool = new Pool({
    connectionString: process.env.DATABASE_URL,
    ssl: { rejectUnauthorized: false },
    connectionTimeoutMillis: 30000,
    query_timeout: 120000,
    keepAlive: true,
    keepAliveInitialDelayMillis: 10000,
  });

  async function setupDatabase() {
    const client = await pool.connect();

    try {
      const connection = await client.query(`
        SELECT current_database() AS database_name,
               COALESCE(
                 (SELECT ssl
                  FROM pg_stat_ssl
                  WHERE pid = pg_backend_pid()),
                 false
               ) AS ssl_enabled
      `);

      console.log(`Connected to database: ${connection.rows[0].database_name}`);
      console.log(`SSL enabled: ${connection.rows[0].ssl_enabled}`);

      const before = await client.query(`
        SELECT EXISTS (
          SELECT 1
          FROM information_schema.tables
          WHERE table_schema = current_schema()
            AND table_name = 'students'
        ) AS exists
      `);
      console.log(`students table before setup: ${before.rows[0].exists ? 'exists' : 'missing'}`);

      let schema = fs.readFileSync(
        path.join(process.cwd(), 'database', '01_schema.sql'),
        'utf8'
      );

      // Allow the schema's CREATE statements to be safely rerun.
      schema = schema
        .replace(/\bCREATE\s+TABLE\s+(?!IF\s+NOT\s+EXISTS\b)/gi, 'CREATE TABLE IF NOT EXISTS ')
        .replace(/\bCREATE\s+INDEX\s+(?!IF\s+NOT\s+EXISTS\b)/gi, 'CREATE INDEX IF NOT EXISTS ');

      await client.query('BEGIN');
      try {
        await client.query(schema);

        await client.query(
          "SELECT pg_advisory_xact_lock(hashtext('smart-school-seed-students'))"
        );

        const count = await client.query(
          'SELECT COUNT(*)::int AS count FROM students'
        );

        if (count.rows[0].count === 0) {
          await client.query(
            `INSERT INTO students (name, reg_number, class, gender, photo_url)
             VALUES ($1, $2, $3, $4, $5)
             ON CONFLICT (reg_number) DO NOTHING`,
            ['ASIFIWE Josue', 'MIPC/2026/0', 'Unassigned', 'Unknown', 'default.png']
          );
          console.log('Inserted the sample student.');
        } else {
          console.log(`Skipped sample student; students already contains ${count.rows[0].count} record(s).`);
        }

        const expectedTables = [
          'users',
          'user_sessions',
          'students',
          'smart_cards',
          'attendance_logs',
          'permissions',
          'fees_ledger',
          'fees_payments',
        ];

        const tables = await client.query(
          `SELECT table_name
           FROM information_schema.tables
           WHERE table_schema = current_schema()
             AND table_name = ANY($1::text[])`,
          [expectedTables]
        );
        const existingTables = new Set(tables.rows.map(row => row.table_name));
        const missingTables = expectedTables.filter(name => !existingTables.has(name));

        if (missingTables.length > 0) {
          throw new Error(`Missing expected tables: ${missingTables.join(', ')}`);
        }

        const columns = await client.query(
          `SELECT column_name
           FROM information_schema.columns
           WHERE table_schema = current_schema()
             AND table_name = 'students'`
        );
        const existingColumns = new Set(columns.rows.map(row => row.column_name));
        const expectedColumns = [
          'id',
          'name',
          'reg_number',
          'class',
          'gender',
          'photo_url',
        ];
        const missingColumns = expectedColumns.filter(name => !existingColumns.has(name));

        if (missingColumns.length > 0) {
          throw new Error(`students is missing expected columns: ${missingColumns.join(', ')}`);
        }

        const finalCount = await client.query(
          'SELECT COUNT(*)::int AS count FROM students'
        );

        await client.query('COMMIT');

        console.log(`Verified core tables: ${expectedTables.join(', ')}`);
        console.log(`Verified students columns: ${expectedColumns.join(', ')}`);
        console.log(`Student record count: ${finalCount.rows[0].count}`);
        console.log('Database setup completed successfully.');
      } catch (error) {
        await client.query('ROLLBACK');
        throw error;
      }
    } finally {
      client.release();
    }
  }

  setupDatabase()
    .catch(error => {
      console.error('Database setup failed:', error.message);
      process.exitCode = 1;
    })
    .finally(() => pool.end());
}
'@

$nodeScript | node -
if ($LASTEXITCODE -ne 0) {
    throw 'Database setup failed. See the error message above.'
}# Server Configuration
PORT=5000
