# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_database_password
DB_NAME=smart_school

# Comma-separated origins for the frontend when served separately
CLIENT_ORIGIN=http://localhost:5173

# Optional admin bootstrap values for `npm run seed-admin`
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# Permission notifications (comma-separated admin recipients)
ADMIN_NOTIFICATION_EMAILS=
ADMIN_NOTIFICATION_PHONES=

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Africa's Talking SMS delivery
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Meta WhatsApp Cloud API (guardian_phone must be in E.164 format)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_VERSION=
META_WHATSAPP_TEMPLATE_APPROVED=
META_WHATSAPP_TEMPLATE_OVERDUE=
META_WHATSAPP_TEMPLATE_LANGUAGE=en
